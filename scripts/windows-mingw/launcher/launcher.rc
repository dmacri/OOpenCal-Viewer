// Resources of the launcher: the icon of OOpenCal-Viewer.exe (what Explorer, the taskbar and a shortcut show) and its description.
#include <winver.h>

1 ICON "OOpenCal-Viewer.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "OOpenCal-Viewer (portable launcher)"
            VALUE "InternalName", "OOpenCal-Viewer"
            VALUE "OriginalFilename", "OOpenCal-Viewer.exe"
            VALUE "ProductName", "OOpenCal-Viewer"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
